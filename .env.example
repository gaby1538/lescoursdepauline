# Copiez ce fichier en .env.local et remplissez les valeurs.
# .env.local n'est jamais commité : il est dans .gitignore.

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé de service : serveur uniquement, ne jamais préfixer NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Resend — pour les emails transactionnels
RESEND_API_KEY=
EMAIL_EXPEDITEUR="Les cours de Pauline <contact@lescoursdepauline.com>"

# Adresse publique du site
NEXT_PUBLIC_SITE_URL=https://lescoursdepauline.com

# Administration — adresses autorisées à ouvrir /admin, séparées par des virgules.
# Si cette variable est absente, personne n'y accède.
ADMIN_EMAILS=contact.capsvt@gmail.com
